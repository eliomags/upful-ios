{
  "name": "jyanik-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production",
    "lint": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply jyanik-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply jyanik-db --remote",
    "db:studio": "wrangler d1 execute jyanik-db --local --command '.tables'",
    "test": "vitest"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "jose": "^5.9.0",
    "bcryptjs": "^2.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241205.0",
    "@types/bcryptjs": "^2.4.6",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0",
    "wrangler": "^3.99.0"
  }
}
